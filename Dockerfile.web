# ── Stage 1: Build the SPA ──────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# VITE_API_BASE_URL is deliberately left unset.
#
# apiClient falls back to '' (a relative URL) on any non-localhost host, so the
# browser calls /api/... on whatever origin served the page. Caddy proxies that
# to the API container. Same origin means no CORS preflight, no cross-site
# cookie questions, and no rebuild when the server's address changes.
RUN npm run build

# ── Stage 2: Serve ──────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# A single-page app: every unknown path is a client-side route and must fall
# through to index.html, or a refresh on /app/risk returns 404.
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  # Hashed asset filenames are safe to cache indefinitely.' \
  '  location /assets/ {' \
  '    expires 1y;' \
  '    add_header Cache-Control "public, immutable";' \
  '  }' \
  '  # index.html must never be cached, or a deploy ships stale asset refs.' \
  '  location = /index.html {' \
  '    add_header Cache-Control "no-cache, must-revalidate";' \
  '  }' \
  '  location / {' \
  '    try_files $uri $uri/ /index.html;' \
  '  }' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
