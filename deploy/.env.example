# Copy to .env on the server, fill in, then: chmod 600 .env
# Never commit the filled-in version.

# ── Where the images come from ──────────────────────────────────
# Your GitHub username or organisation, lowercase.
GH_OWNER=your-github-username

# Which build to run. CI sets this to the commit SHA; `latest` follows main.
# Pinning to a SHA is how you roll back: TAG=<old-sha> docker compose up -d
TAG=latest

# ── Secrets ─────────────────────────────────────────────────────
# Generate both. Do not reuse anything from a previous environment.
#   openssl rand -base64 32   → POSTGRES_PASSWORD
#   openssl rand -hex 32      → JWT_SECRET   (must be at least 32 characters;
#                                             the API refuses to boot otherwise)
POSTGRES_PASSWORD=
JWT_SECRET=

# ── How the site is addressed ───────────────────────────────────
# IP-only deployment (no domain): keep these as they are. Caddy issues a
# self-signed certificate — the browser warns once, but traffic is encrypted.
SITE_ADDRESS=:443
TLS_CONFIG=tls internal

# When you have a domain, swap to these two lines instead and restart Caddy.
# Caddy then obtains and renews a real Let's Encrypt certificate automatically.
# SITE_ADDRESS=grc.yourdomain.com
# TLS_CONFIG=

# ── CORS ────────────────────────────────────────────────────────
# Leave empty. The SPA and the API are served from the same origin, so no
# cross-origin request is made. Only set this if you later host the UI on a
# separate hostname — comma-separated, no trailing slashes.
CORS_ORIGINS=

# ── First administrator ─────────────────────────────────────────
# Read once by `docker compose exec api npm run provision`.
# Leave BOOTSTRAP_ADMIN_PASSWORD empty and provision will generate a strong one
# and print it a single time; you will be forced to change it at first sign-in.
# Clear all three from this file once you have signed in successfully.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
