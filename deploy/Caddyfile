# One origin serves the SPA and the API.
#
# TLS is controlled entirely by the SITE_ADDRESS scheme set in .env:
#
#   IP-only, no domain yet:
#     SITE_ADDRESS=http://:80
#   Listens on port 80 on every interface and matches any Host header, so the
#   server answers on its IP. Plain HTTP — no certificate, no browser warning.
#
#   Do NOT put the server's IP here (SITE_ADDRESS=http://161.97.120.202).
#   Caddy runs inside a container whose only interfaces are loopback and the
#   bridge address; the host's public IP is not among them. Naming it makes the
#   site address impossible to serve from in here, and the useful form — bind
#   everywhere, match anything — is the one with no host at all.
#
#   Production with a real domain (recommended):
#     SITE_ADDRESS=app.yourdomain.com
#   Caddy automatically obtains and renews a Let's Encrypt certificate.
#   No other changes needed — just point your DNS to this server IP.

{
	# The admin API binds to localhost inside the container and is not needed.
	admin off
}

{$SITE_ADDRESS:http://:80} {

	encode gzip zstd

	# Requests the API owns. Listed before the catch-all because Caddy matches
	# handle blocks in the order written.
	handle /api/* {
		reverse_proxy api:3000
	}

	# Uploaded documents are served by the API so its own headers apply.
	handle /uploads/* {
		reverse_proxy api:3000
	}

	handle /health {
		reverse_proxy api:3000
	}

	# Everything else is the single-page app.
	handle {
		reverse_proxy web:80
	}

	header {
		# Belt and braces alongside helmet: these apply to the static assets too.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Tells browsers not to advertise the server software.
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
