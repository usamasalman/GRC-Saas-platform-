# One origin serves the SPA and the API.
#
# TLS is controlled entirely by the SITE_ADDRESS scheme set in .env:
#
#   IP-only, no domain yet:
#     SITE_ADDRESS=http://:80
#   Listens on port 80 on every interface and matches any Host header, so the
#   server answers on its IP. Plain HTTP — no certificate, no browser warning.
#
#   Do NOT put the server's IP here (SITE_ADDRESS=http://161.97.120.202).
#   Caddy runs inside a container whose only interfaces are loopback and the
#   bridge address; the host's public IP is not among them.
#
#   Production with a real domain (recommended):
#     SITE_ADDRESS=app.yourdomain.com
#   Caddy automatically obtains and renews a Let's Encrypt certificate.

{
	# The admin API must stay on: `caddy reload` works by POSTing the new config
	# to it, and the deploy reloads rather than restarting so in-flight requests
	# are not dropped. This was `admin off`, which made every reload fail with
	# `dial tcp [::1]:2019: connect: connection refused`.
	#
	# localhost here is the container's own loopback. No port is published for
	# 2019, so it is reachable only by a process inside this container — which is
	# exactly what `docker compose exec caddy caddy reload` is.
	admin localhost:2019
}

{$SITE_ADDRESS:http://:80} {

	encode gzip zstd

	# ── Why the upstreams are declared this way ──────────────────────────────
	#
	# `reverse_proxy api:3000` resolves that hostname once, when the config
	# loads, and holds the resulting IP. A deploy recreates the api and web
	# containers with new bridge addresses while leaving Caddy running, so Caddy
	# keeps dialling an address that now belongs to something else — producing
	# `dial tcp 192.168.144.x:3000: connect: connection refused` on every
	# request, for a container that is itself perfectly healthy.
	#
	# `dynamic a` re-resolves through Docker's embedded DNS on the refresh
	# interval instead, so a recreated container is picked up on its own.
	#
	# lb_try_duration covers the few seconds during a deploy when the container
	# genuinely is gone: retry briefly rather than returning 502 to a user who
	# happened to click at the wrong moment.

	# Everything the API owns. One matcher rather than three handle blocks, so
	# the upstream is declared once and cannot drift between them.
	@api path /api/* /uploads/* /health

	handle @api {
		reverse_proxy {
			dynamic a {
				name api
				port 3000
				refresh 10s
				# Docker's embedded DNS. Naming it explicitly rather than relying
				# on whatever /etc/resolv.conf happens to hold in the image.
				resolvers 127.0.0.11
			}
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	# Everything else is the single-page app.
	handle {
		reverse_proxy {
			dynamic a {
				name web
				port 80
				refresh 10s
				resolvers 127.0.0.11
			}
			lb_try_duration 10s
			lb_try_interval 500ms
		}
	}

	header {
		# Belt and braces alongside helmet: these apply to the static assets too.
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
