# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# Prisma datasource. Local development uses the bundled SQLite file.
DATABASE_URL="file:./dev.db"

# Signing key for API access tokens. Must be at least 32 characters or the
# server refuses to start. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Optional — origin allowed by CORS. Defaults to http://localhost:5173.
# FRONTEND_URL=http://localhost:5173

# Optional — server port. Defaults to 3000.
# PORT=3000
