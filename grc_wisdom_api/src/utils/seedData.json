   "id": "DOC-001",
   "code": "POL-SEC-001",
   "title": "Enterprise Information Security Policy",
   "category": "Policy",
   "department": "Information Security",
   "classification": "Confidential",
   "owner": "Eleanor Vance",
   "status": "Draft",
   "version": "1.0",
   "checkedOutBy": null,
   "content": "<h2>1. Purpose</h2><p>This policy establishes the information security governance requirements of Global Bank.</p><h2>2. Scope</h2><p>It applies to all personnel, information assets, locations, suppliers and technology services.</p><h2>3. Governance Requirements</h2><p>Control owners shall maintain evidence, report exceptions and complete periodic effectiveness reviews.</p>",
