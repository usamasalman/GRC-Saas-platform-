   "id": "DOC-002",
   "code": "PRO-ACC-014",
   "title": "User Access Management Procedure",
   "category": "Procedure",
   "department": "IT Operations",
   "classification": "Internal",
   "owner": "Eleanor Vance",
   "status": "Pending Approval",
   "version": "2.1",
   "checkedOutBy": null,
   "content": "<h2>Access Lifecycle</h2><p>Access shall be approved, provisioned, reviewed, modified and revoked through controlled workflows.</p><h2>Privileged Access</h2><p>Privileged roles require MFA, time-bound authorization and monthly review.</p>",
