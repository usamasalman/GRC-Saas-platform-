generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  type          String         // e.g., "HOLDING", "SAAS", "MULTIBRANCH", "PARTNER"
  
  // Phase 3: Multi-Entity Governance (Materialized Path Tree)
  parentId      String?
  parent        Tenant?        @relation("TenantHierarchy", fields: [parentId], references: [id])
  children      Tenant[]       @relation("TenantHierarchy")
  path          String         @default("/") // e.g., /GROUP_1/ORG_2/BRANCH_3/

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  subscriptions Subscription[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  documents     Document[]
  apiKeys       ApiKey[]
  webhooks      WebhookEndpoint[]
  riskSnapshots RiskScoreSnapshot[]
  tickets       Ticket[]
  asmAssets     AsmAsset[]
  phishCampaigns PhishCampaign[]
  impersonationSessions ImpersonationSession[]
  roles         Role[]
  workflowDefinitions WorkflowDefinition[]
  workflowRuns  WorkflowRun[]
  catalogItems  ServiceCatalogItem[]
  slaPolicies   SlaPolicy[]
  knowledgeArticles KnowledgeArticle[]
  controls      Control[]
  standardEnablements TenantStandardEnablement[]
  implementations ControlImplementation[]
  evidence      Evidence[]
  risks         Risk[]
  audits        Audit[]
  issues        Issue[]
  riskAppetites RiskAppetite[]
  rcsaCampaigns RcsaCampaign[]
  rcsaAssessments RcsaAssessment[]
  kris          Kri[]
  kriReadings   KriReading[]
  lossEvents    LossEvent[]
  auditableEntities AuditableEntity[]
  auditPlans    AuditPlan[]
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  name          String
  passwordHash  String
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Display label, kept for the existing UI and for roles not yet mapped.
  role          String
  /// Authoritative link to the capability-granting Role record.
  roleId        String?
  roleRef       Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  profile       String?
  context       String?
  branch        String?
  department    String?
  status        String   @default("Active")
  
  // Phase 1: Trust Foundation (MFA)
  mfaEnabled    Boolean  @default(false)
  mfaSecret     String?
  backupCodes   String?  // JSON string array

  // Phase 0: Refresh token rotation (TRD §9)
  refreshTokenHash      String?
  refreshTokenExpiresAt DateTime?

  // Phase 0: Forced credential rotation after admin reset or first login
  mustChangePassword    Boolean  @default(false)

  passwordResetRequests PasswordResetRequest[]
  impersonationsRequested ImpersonationSession[] @relation("ImpersonationRequester")
  impersonationsAsSubject ImpersonationSession[] @relation("ImpersonationSubject")
  impersonationsApproved  ImpersonationSession[] @relation("ImpersonationApprover")
  workflowRunsStarted     WorkflowRun[]     @relation("WorkflowStarter")
  workflowStepsAssigned   WorkflowStepRun[] @relation("WorkflowAssignee")
  workflowStepsDecided    WorkflowStepRun[] @relation("WorkflowDecider")
  ticketComments          TicketComment[]   @relation("TicketCommentAuthor")
  ticketWorkNotes         TicketWorkNote[]  @relation("TicketWorkNoteAuthor")
  knowledgeArticles       KnowledgeArticle[] @relation("KnowledgeAuthor")
  standardsOwned          TenantStandardEnablement[] @relation("StandardOwner")
  implementationsOwned    ControlImplementation[] @relation("ImplementationOwner")
  implementationsOperated ControlImplementation[] @relation("ImplementationOperator")
  implementationsValidated ControlImplementation[] @relation("ImplementationValidator")
  evidenceUploaded        Evidence[] @relation("EvidenceUploader")
  evidenceReviewed        Evidence[] @relation("EvidenceReviewer")
  risksOwned              Risk[] @relation("RiskOwner")
  risksAccepted           Risk[] @relation("RiskAcceptor")
  treatmentsOwned         RiskTreatmentAction[] @relation("TreatmentOwner")
  auditsLed               Audit[] @relation("AuditLead")
  issuesRaised            Issue[] @relation("IssueRaiser")
  issuesCapOwned          Issue[] @relation("IssueCapOwner")
  issuesResponded         Issue[] @relation("IssueResponder")
  issuesClosed            Issue[] @relation("IssueCloser")
  appetitesSet            RiskAppetite[] @relation("AppetiteSetter")
  appetitesApproved       RiskAppetite[] @relation("AppetiteApprover")
  campaignsLaunched       RcsaCampaign[] @relation("CampaignLauncher")
  rcsaResponses           RcsaAssessment[] @relation("RcsaRespondent")
  krisOwned               Kri[] @relation("KriOwner")
  kriReadingsRecorded     KriReading[] @relation("KriRecorder")
  lossEventsReported      LossEvent[] @relation("LossReporter")
  entitiesOwned           AuditableEntity[] @relation("EntityOwner")
  plansPrepared           AuditPlan[] @relation("PlanPreparer")
  plansApproved           AuditPlan[] @relation("PlanApprover")
  planItemsLed            AuditPlanItem[] @relation("PlanItemLead")
  proceduresAssigned      TestProcedure[] @relation("ProcedureAssignee")
  testsExecuted           TestResult[] @relation("TestExecutor")
  workpapersPrepared      Workpaper[] @relation("WorkpaperPreparer")
  workpapersReviewed      Workpaper[] @relation("WorkpaperReviewer")
  reviewNotesRaised       WorkpaperReviewNote[] @relation("ReviewNoteRaiser")
  reviewNotesCleared      WorkpaperReviewNote[] @relation("ReviewNoteClearer")

  // Phase 2: Saudi Usability (PDPL Encrypted PII)
  encryptedNationalId String?
  encryptedPhone      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  auditLogs     AuditLog[]
  documentsOwned Document[]
  approvals     ApprovalQueue[]
  acknowledgements Acknowledgement[]
  ticketsAssigned Ticket[] @relation("AssignedTickets")
  ticketsRequested Ticket[] @relation("RequestedTickets")
}

model Plan {
  id            String         @id @default(uuid())
  name          String         // e.g., "Essentials", "Professional", "Enterprise"
  priceMonthly  Decimal
  maxUsers      Int
  features      String         // JSON string
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan     @relation(fields: [planId], references: [id])
  status        String   // e.g., "ACTIVE", "PENDING", "CANCELLED"
  startDate     DateTime @default(now())
  endDate       DateTime?
}

model Invoice {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  amount        Decimal
  currency      String   @default("SAR")
  status        String   // e.g., "PAID", "UNPAID"
  
  // Phase 2: ZATCA Compliance
  zatcaXml      String?  
  zatcaHash     String?  
  zatcaQr       String?  
  isCleared     Boolean  @default(false) 

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------
// PHASE 1: TRUST FOUNDATION (IMMUTABLE AUDIT & DOCUMENTS)
// ----------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action        String   // e.g., "DOCUMENT_PUBLISHED", "MFA_ENABLED"
  subjectType   String?  // e.g. "Document", "Invoice" — enables O(indexed) SoD lookups
  subjectId     String?  // uuid of the affected record
  payload       String   // JSON string
  previousHash  String
  currentHash   String   @unique
  timestamp     DateTime @default(now())
  wormLocked    Boolean  @default(true) // Enforces Write-Once-Read-Many

  @@index([tenantId, actorId, action, subjectId])
}

// ----------------------------------------------------------------------
// PHASE 0: PASSWORD RESET REQUEST (admin-approved reset workflow)
// ----------------------------------------------------------------------

model PasswordResetRequest {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestedAt        DateTime @default(now())
  requestedIp        String?
  requestedUa        String?
  status             String   @default("PENDING")  // PENDING | APPROVED | DENIED | USED | EXPIRED
  reviewedById       String?
  reviewedAt         DateTime?
  reviewNote         String?
  resetCodeHash      String?  // bcrypt of the one-time reset code
  resetCodeExpiresAt DateTime?
  usedAt             DateTime?

  @@index([userId, status])
  @@index([status, requestedAt])
}

// ----------------------------------------------------------------------
// PHASE 4: GRC CORE — STANDARDS, CONTROLS, IMPLEMENTATIONS, EVIDENCE
// (TRD §7.2)
// ----------------------------------------------------------------------

/// A published framework (ISO 27001, NCA ECC, Saudi PDPL, SOC 2…).
model Standard {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  authority   String
  version     String
  description String?
  isSystem    Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clauses     StandardClause[]
  enablements TenantStandardEnablement[]
}

/// An individually addressable requirement inside a standard.
model StandardClause {
  id         String   @id @default(uuid())
  standardId String
  standard   Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  ref        String
  title      String
  text       String?

  links      ControlClauseLink[]

  @@unique([standardId, ref])
}

/// A library control. tenantId null = platform library; non-null = custom.
model Control {
  id        String   @id @default(uuid())
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  code      String
  title     String
  objective String
  domain    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clauseLinks     ControlClauseLink[]
  implementations ControlImplementation[]

  @@unique([tenantId, code])
  @@index([domain])
}

/// Join table, not an embedded array — TRD §7.1 requires independent
/// queryability ("show all controls mapped to ISO 27001 A.12").
model ControlClauseLink {
  id        String         @id @default(uuid())
  controlId String
  control   Control        @relation(fields: [controlId], references: [id], onDelete: Cascade)
  clauseId  String
  clause    StandardClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  @@unique([controlId, clauseId])
}

/// Per-tenant activation of a standard.
model TenantStandardEnablement {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  standardId    String
  standard      Standard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  applicability String   @default("Full")
  ownerId       String?
  owner         User?    @relation("StandardOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  enabledAt     DateTime @default(now())

  @@unique([tenantId, standardId])
}

/// The tenant-specific instantiation of a library Control.
model ControlImplementation {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  controlId       String
  control         Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)

  title           String
  ownerId         String
  owner           User     @relation("ImplementationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /// Who actually performs the control day to day.
  operatorId      String?
  operator        User?    @relation("ImplementationOperator", fields: [operatorId], references: [id], onDelete: SetNull)

  frequency       String   @default("Quarterly")
  successCriteria String

  /// NotStarted | InProgress | Implemented | Verified
  status          String   @default("NotStarted")
  /// NotAssessed | Effective | PartiallyEffective | Ineffective
  effectiveness   String   @default("NotAssessed")

  nextDueDate     DateTime?
  lastReviewedAt  DateTime?

  /// Independent validation — validator must differ from the implementer
  /// (TRD §7.2), enforced through the SoD engine.
  submittedAt     DateTime?
  validatedById   String?
  validatedBy     User?    @relation("ImplementationValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt     DateTime?
  validationNote  String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  evidence        Evidence[]
  riskLinks       RiskControlLink[]
  engagementRisks EngagementRisk[]
  rcsaAssessments RcsaAssessment[]

  @@index([tenantId, status])
  @@index([nextDueDate])
}

/// Evidence that a control actually operated. The four reviewer judgements are
/// first-class columns, not free text (TRD §7.2).
model Evidence {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  implementationId String
  implementation   ControlImplementation @relation(fields: [implementationId], references: [id], onDelete: Cascade)

  title            String
  description      String?
  fileUrl          String?
  fileName         String?
  classification   String   @default("Internal")

  uploadedById     String
  uploadedBy       User     @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  // NotAssessed | Yes | Partial | No
  relevance        String   @default("NotAssessed")
  sufficiency      String   @default("NotAssessed")
  authenticity     String   @default("NotAssessed")
  currency         String   @default("NotAssessed")

  reviewedById     String?
  reviewedBy       User?    @relation("EvidenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  reviewNote       String?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantId, implementationId])
}

// ----------------------------------------------------------------------
// PHASE 4: GRC CORE — RISK REGISTER (TRD §7.2)
// ----------------------------------------------------------------------

model Risk {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ref                String
  title              String
  /// Cause → event → impact narrative.
  description        String
  category           String

  ownerId            String
  owner              User     @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  /// Open | UnderTreatment | Accepted | Closed
  status             String   @default("Open")
  /// Accept | Mitigate | Transfer | Avoid
  treatmentType      String   @default("Mitigate")

  inherentLikelihood Int
  inherentImpact     Int
  inherentScore      Int
  /// Residual is COMPUTED from linked-control effectiveness, never client-set.
  residualLikelihood Int
  residualImpact     Int
  residualScore      Int

  /// Time-bound acceptance requires an approval record (TRD §7.2).
  acceptedById       String?
  acceptedBy         User?    @relation("RiskAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedUntil      DateTime?
  acceptanceReason   String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  controlLinks       RiskControlLink[]
  treatments         RiskTreatmentAction[]
  kris               Kri[]
  lossEvents         LossEvent[]

  @@unique([tenantId, ref])
  @@index([tenantId, status])
}

/// Join table so "which risks does this control mitigate" stays queryable.
model RiskControlLink {
  id               String                @id @default(uuid())
  riskId           String
  risk             Risk                  @relation(fields: [riskId], references: [id], onDelete: Cascade)
  implementationId String
  implementation   ControlImplementation @relation(fields: [implementationId], references: [id], onDelete: Cascade)

  @@unique([riskId, implementationId])
}

model RiskTreatmentAction {
  id        String   @id @default(uuid())
  riskId    String
  risk      Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  title     String
  ownerId   String
  owner     User     @relation("TreatmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  dueDate   DateTime?
  /// Open | Done
  status    String   @default("Open")
  createdAt DateTime @default(now())
  doneAt    DateTime?

  @@index([riskId, status])
}

// ----------------------------------------------------------------------
// PHASE 4: INTERNAL AUDIT — UNIVERSE & RISK-BASED ANNUAL PLAN
// (IIA Global Internal Audit Standards 2024, Domain IV/V)
// ----------------------------------------------------------------------

/// The audit universe: every entity that COULD be audited. This is the
/// population the annual risk assessment scores and the plan selects from.
/// Engagements originate here — never ad hoc.
model AuditableEntity {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ref           String
  name          String
  /// Process | BusinessUnit | System | ThirdParty | LegalEntity
  type          String   @default("Process")
  description   String?

  /// Self-referential so a universe can mirror the org/process hierarchy.
  parentId      String?
  parent        AuditableEntity?  @relation("UniverseTree", fields: [parentId], references: [id])
  children      AuditableEntity[] @relation("UniverseTree")

  ownerId       String?
  owner         User?    @relation("EntityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  // ── Annual risk-assessment factors, each scored 1–5 ──────────────────
  financialMateriality Int @default(3)
  regulatoryExposure   Int @default(3)
  complexity           Int @default(3)
  changeVolatility     Int @default(3)
  priorFindings        Int @default(3)
  fraudExposure        Int @default(3)

  /// Weighted composite (1.00–5.00), computed server-side — never client-set.
  riskScore     Float    @default(3)
  /// High | Medium | Low, derived from riskScore.
  riskTier      String   @default("Medium")

  lastAuditedAt DateTime?
  auditCycleMonths Int   @default(24)

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planItems     AuditPlanItem[]

  @@unique([tenantId, ref])
  @@index([tenantId, riskTier])
}

/// The annual audit plan. Approved by the audit committee; deviations are
/// reported against it. Finite hours are allocated to the highest-risk entities.
model AuditPlan {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  year           Int
  title          String
  /// Draft | SubmittedForApproval | Approved | Active | Closed
  status         String   @default("Draft")

  /// Total auditor capacity available for the year.
  totalBudgetHours Int    @default(0)

  preparedById   String
  preparedBy     User     @relation("PlanPreparer", fields: [preparedById], references: [id], onDelete: Cascade)

  /// Committee approval — approver must differ from preparer (SoD).
  submittedAt    DateTime?
  approvedById   String?
  approvedBy     User?    @relation("PlanApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt     DateTime?
  approvalNote   String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items          AuditPlanItem[]

  @@unique([tenantId, year])
  @@index([tenantId, status])
}

/// One planned engagement. An Audit is instantiated FROM this.
model AuditPlanItem {
  id                String   @id @default(uuid())
  planId            String
  plan              AuditPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  auditableEntityId String
  auditableEntity   AuditableEntity @relation(fields: [auditableEntityId], references: [id], onDelete: Cascade)

  /// 1–4
  plannedQuarter    Int      @default(1)
  budgetHours       Int      @default(80)
  /// Why this entity made the plan — the risk-based justification.
  rationale         String?

  assignedLeadId    String?
  assignedLead      User?    @relation("PlanItemLead", fields: [assignedLeadId], references: [id], onDelete: SetNull)

  /// Planned | InProgress | Completed | Deferred | Cancelled
  status            String   @default("Planned")
  deferralReason    String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  /// Set once the engagement is instantiated.
  audit             Audit?

  @@unique([planId, auditableEntityId])
  @@index([planId, status])
}

// ----------------------------------------------------------------------
// PHASE 4: GRC CORE — AUDIT PROGRAMME (TRD §7.2)
// ----------------------------------------------------------------------

model Audit {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ref            String
  title          String
  objective      String
  scope          String
  criteria       String

  leadAuditorId  String
  leadAuditor    User     @relation("AuditLead", fields: [leadAuditorId], references: [id], onDelete: Cascade)

  /// Engagements originate from an approved plan item (IIA Std 9.4).
  planItemId     String?  @unique
  planItem       AuditPlanItem? @relation(fields: [planItemId], references: [id], onDelete: SetNull)

  /// Planned | Fieldwork | Reporting | Closed
  status         String   @default("Planned")
  startDate      DateTime?
  endDate        DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  issues         Issue[]
  engagementRisks EngagementRisk[]
  workpapers     Workpaper[]

  @@unique([tenantId, ref])
  @@index([tenantId, status])
}

/// Criterion / condition / cause / recommendation are the four mandatory
/// finding fields; closure is independently validated and reopenable.
/// Central, cross-source issue register.
///
/// Findings arrive from internal audit, external audit, regulators, incidents
/// and self-identification. They all land here so aging, escalation and
/// ownership are managed in one place rather than per-source. Audit-originated
/// issues additionally carry the IIA criterion/condition/cause structure.
model Issue {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ref            String

  /// InternalAudit | ExternalAudit | Regulator | SelfIdentified | Incident | RiskAssessment
  source         String   @default("InternalAudit")
  /// External identifier: regulator letter, external audit report, incident id.
  sourceReference String?

  /// Only audit-sourced issues link to an engagement.
  auditId        String?
  audit          Audit?   @relation(fields: [auditId], references: [id], onDelete: SetNull)

  title          String

  // IIA finding structure — mandatory for InternalAudit, optional elsewhere.
  criterion      String?
  condition      String?
  cause          String?
  recommendation String

  /// High | Medium | Low
  riskRating     String   @default("Medium")

  /// Open | Responded | Disputed | CAPAssigned | PendingClosure | Closed | Reopened
  status         String   @default("Open")

  raisedById     String
  raisedBy       User     @relation("IssueRaiser", fields: [raisedById], references: [id], onDelete: Cascade)

  identifiedDate  DateTime  @default(now())
  targetCloseDate DateTime?

  // ── Management response ────────────────────────────────────────────────
  // Management must formally accept or dispute before remediation begins.
  /// Agree | PartiallyAgree | Disagree
  responseType         String?
  responseNarrative    String?
  managementActionPlan String?
  respondedById        String?
  respondedBy          User?     @relation("IssueResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedAt          DateTime?

  // ── Corrective action plan ─────────────────────────────────────────────
  capOwnerId     String?
  capOwner       User?    @relation("IssueCapOwner", fields: [capOwnerId], references: [id], onDelete: SetNull)
  capDueDate     DateTime?
  capDescription String?

  // ── Closure ────────────────────────────────────────────────────────────
  closedById     String?
  closedBy       User?    @relation("IssueCloser", fields: [closedById], references: [id], onDelete: SetNull)
  closedAt       DateTime?
  closureNote    String?
  reopenedCount  Int      @default(0)
  escalationLevel Int     @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  testResults    TestResult[]
  rcsaAssessments RcsaAssessment[]
  kriReadings    KriReading[]
  lossEvents     LossEvent[]

  @@unique([tenantId, ref])
  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([auditId])
}

// ----------------------------------------------------------------------
// PHASE 4: INTERNAL AUDIT — RISK & CONTROL MATRIX, TESTING, WORKPAPERS
// (IIA Standards Domain V — performing internal audit services)
// ----------------------------------------------------------------------

/// One row of the engagement's Risk & Control Matrix: a process risk in scope,
/// and the control relied upon to mitigate it.
model EngagementRisk {
  id          String   @id @default(uuid())
  auditId     String
  audit       Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  ref         String
  title       String
  description String

  /// High | Medium | Low — the risk to the engagement objective.
  riskRating  String   @default("Medium")

  /// The tenant's control relied upon. Optional: a risk may have no control,
  /// which is itself a finding (control gap).
  implementationId String?
  implementation   ControlImplementation? @relation(fields: [implementationId], references: [id], onDelete: SetNull)

  /// Preventive | Detective | Corrective
  controlType String?
  /// Manual | Automated | Hybrid
  controlNature String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  procedures  TestProcedure[]

  @@unique([auditId, ref])
  @@index([auditId])
}

/// The planned test for an RCM row. Sampling method and size are recorded
/// up front so the conclusion is reproducible.
model TestProcedure {
  id               String   @id @default(uuid())
  engagementRiskId String
  engagementRisk   EngagementRisk @relation(fields: [engagementRiskId], references: [id], onDelete: Cascade)

  ref              String
  objective        String
  /// The step-by-step procedure the auditor will perform.
  procedure        String

  /// DesignEffectiveness | OperatingEffectiveness | Both
  testType         String   @default("OperatingEffectiveness")
  /// Statistical | Judgmental | FullPopulation | Inquiry | Observation
  samplingMethod   String   @default("Judgmental")
  populationSize   Int?
  sampleSize       Int      @default(25)

  /// NotStarted | InProgress | Completed
  status           String   @default("NotStarted")

  assignedToId     String?
  assignedTo       User?    @relation("ProcedureAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  result           TestResult?
  workpapers       Workpaper[]

  @@unique([engagementRiskId, ref])
}

/// The outcome of executing a test procedure. An unsatisfactory conclusion is
/// what legitimately gives rise to a finding.
model TestResult {
  id             String   @id @default(uuid())
  procedureId    String   @unique
  procedure      TestProcedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  itemsTested    Int
  exceptionsFound Int     @default(0)
  /// Satisfactory | SatisfactoryWithExceptions | Unsatisfactory
  conclusion     String
  narrative      String

  testedById     String
  testedBy       User     @relation("TestExecutor", fields: [testedById], references: [id], onDelete: Cascade)
  testedAt       DateTime @default(now())

  /// Set when the exception was escalated into a reportable finding.
  findingId      String?
  finding        Issue?   @relation(fields: [findingId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
}

/// The indexed evidence file. Preparer → reviewer sign-off is what makes the
/// engagement survive an external quality assessment (IIA Std 12.1/14.5).
model Workpaper {
  id           String   @id @default(uuid())
  auditId      String
  audit        Audit    @relation(fields: [auditId], references: [id], onDelete: Cascade)

  /// Cross-reference index, e.g. "B-2.1".
  ref          String
  title        String
  /// Planning | Fieldwork | Reporting
  section      String   @default("Fieldwork")

  content      String?
  fileUrl      String?
  fileName     String?

  /// Optional tie to the test this paper evidences.
  procedureId  String?
  procedure    TestProcedure? @relation(fields: [procedureId], references: [id], onDelete: SetNull)

  preparedById String
  preparedBy   User     @relation("WorkpaperPreparer", fields: [preparedById], references: [id], onDelete: Cascade)
  preparedAt   DateTime @default(now())

  /// Draft | SubmittedForReview | Reviewed | Returned
  status       String   @default("Draft")

  reviewedById String?
  reviewedBy   User?    @relation("WorkpaperReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewConclusion String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewNotes  WorkpaperReviewNote[]

  @@unique([auditId, ref])
  @@index([auditId, status])
}

/// A reviewer's coaching note. Every note must be cleared before the paper
/// can be signed off — this is the review trail regulators look for.
model WorkpaperReviewNote {
  id          String   @id @default(uuid())
  workpaperId String
  workpaper   Workpaper @relation(fields: [workpaperId], references: [id], onDelete: Cascade)

  note        String
  raisedById  String
  raisedBy    User     @relation("ReviewNoteRaiser", fields: [raisedById], references: [id], onDelete: Cascade)

  /// Open | Cleared
  status      String   @default("Open")
  response    String?
  clearedById String?
  clearedBy   User?    @relation("ReviewNoteClearer", fields: [clearedById], references: [id], onDelete: SetNull)
  clearedAt   DateTime?

  createdAt   DateTime @default(now())

  @@index([workpaperId, status])
}

// ----------------------------------------------------------------------
// PHASE 1: GENERIC WORKFLOW / AUTOMATION ENGINE (TRD §6.6)
// ----------------------------------------------------------------------

/// A reusable, data-driven approval/automation definition. Steps are a JSON
/// array executed in order by services/workflowEngine.ts. One engine serves
/// every module rather than each re-implementing approval routing.
model WorkflowDefinition {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key          String
  name         String
  description  String?
  /// What the run is about: "Ticket", "Document", "AccessRequest", …
  subjectType  String
  /// JSON array of step objects — see WorkflowStepDef in workflowEngine.ts.
  steps        String   @default("[]")

  isActive     Boolean  @default(true)
  isSystem     Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs         WorkflowRun[]
  catalogItems ServiceCatalogItem[]

  @@unique([tenantId, key])
  @@index([subjectType, isActive])
}

/// One execution of a definition against one subject record.
model WorkflowRun {
  id           String   @id @default(uuid())
  definitionId String
  definition   WorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subjectType  String
  subjectId    String

  /// RUNNING | COMPLETED | REJECTED | CANCELLED
  status       String   @default("RUNNING")
  currentStep  Int      @default(0)
  outcome      String?

  startedById  String
  startedBy    User     @relation("WorkflowStarter", fields: [startedById], references: [id], onDelete: Cascade)
  startedAt    DateTime @default(now())
  completedAt  DateTime?

  stepRuns     WorkflowStepRun[]
  tickets      Ticket[]

  @@index([tenantId, status])
  @@index([subjectType, subjectId])
}

/// A single materialized step within a run — the unit a person acts on.
model WorkflowStepRun {
  id                 String   @id @default(uuid())
  runId              String
  run                WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  stepIndex          Int
  stepKey            String
  /// submit | review | approve | notify | wait | task
  stepType           String
  name               String

  /// PENDING | ACTIVE | APPROVED | REJECTED | DONE | SKIPPED
  status             String   @default("PENDING")

  /// Assignment is by capability and/or explicit user; either may be null.
  assigneeId         String?
  assignee           User?    @relation("WorkflowAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requiredCapability String?
  /// SoD guard evaluated against the run subject before a decision is accepted.
  sodGuardedAction   String?

  decision           String?
  comment            String?
  dueAt              DateTime?

  decidedById        String?
  decidedBy          User?    @relation("WorkflowDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt          DateTime?

  createdAt          DateTime @default(now())

  @@index([runId, stepIndex])
  @@index([assigneeId, status])
  @@index([status, dueAt])
}

// ----------------------------------------------------------------------
// PHASE 3: ITSM (TRD §7.3)
// ----------------------------------------------------------------------

/// A requestable service. Pointing an item at a WorkflowDefinition is what
/// makes routing configuration rather than code.
model ServiceCatalogItem {
  id                   String   @id @default(uuid())
  tenantId             String?
  tenant               Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key                  String
  name                 String
  description          String
  category             String
  /// Incident | ServiceRequest | AccessRequest | Change | SecurityEvent
  ticketType           String
  defaultImpact        String   @default("Medium")
  defaultUrgency       String   @default("Medium")
  assignmentGroup      String?

  workflowDefinitionId String?
  workflowDefinition   WorkflowDefinition? @relation(fields: [workflowDefinitionId], references: [id], onDelete: SetNull)

  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tickets              Ticket[]

  @@unique([tenantId, key])
}

/// Response/resolution targets per computed priority. Tenant rows override
/// the platform defaults (tenantId = null).
model SlaPolicy {
  id           String   @id @default(uuid())
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  priority     String
  responseMins Int
  resolveMins  Int

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, priority])
}

/// Requester-visible correspondence.
model TicketComment {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/// Internal-only notes. Deliberately a SEPARATE table from TicketComment
/// (TRD §7.3) so the visibility rule cannot be lost in a query filter.
model TicketWorkNote {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("TicketWorkNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model KnowledgeArticle {
  id                String   @id @default(uuid())
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  title             String
  body              String
  category          String
  /// JSON arrays.
  tags              String   @default("[]")
  linkedTicketTypes String   @default("[]")

  /// DRAFT | PUBLISHED | ARCHIVED
  status            String   @default("DRAFT")
  authorId          String?
  author            User?    @relation("KnowledgeAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  viewCount         Int      @default(0)
  helpfulCount      Int      @default(0)
  /// Set when an article was spawned from a recurring resolution.
  sourceTicketId    String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, status])
}

// ----------------------------------------------------------------------
// PHASE 1: RBAC CAPABILITY ENGINE (TRD §3.1)
// ----------------------------------------------------------------------

/// The closed set of canonical business capabilities (TRD §5).
/// Seeded from the TRD; not tenant-editable.
model Capability {
  key             String  @id
  name            String
  module          String
  number          Int?
  tenancySpecific Boolean @default(false)

  createdAt       DateTime @default(now())
}

/// A named set of capability grants. Platform roles (tenantId = null) come from
/// TRD Appendix A and are read-only. Tenant-scoped roles are the "custom role
/// builder" TRD §3.1 calls a first-class product feature.
model Role {
  id               String   @id @default(uuid())
  tenantId         String?
  tenant           Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key              String
  name             String
  portal           String
  scopeDescription String?
  businessPurpose  String?

  /// JSON array of Capability.key values.
  capabilityGrants String   @default("[]")

  /// True for the 42 TRD-defined roles — blocks edits and deletion.
  isSystem         Boolean  @default(false)
  requiresMfa      Boolean  @default(false)
  needsReview      Boolean  @default(false)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]

  @@unique([tenantId, key])
  @@index([portal])
}

// ----------------------------------------------------------------------
// PHASE 1: READ-ONLY IMPERSONATION (customer-authorized support access)
// ----------------------------------------------------------------------

model ImpersonationSession {
  id                    String   @id @default(uuid())

  // The platform engineer asking for access.
  requestedById         String
  requestedBy           User     @relation("ImpersonationRequester", fields: [requestedById], references: [id], onDelete: Cascade)

  // The customer user whose view will be assumed.
  subjectUserId         String
  subjectUser           User     @relation("ImpersonationSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)

  // Denormalized for tenant-scoped queries and the customer's own audit view.
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  reason                String
  ticketRef             String?
  requestedDurationMins Int      @default(30)

  // PENDING | APPROVED | DENIED | ACTIVE | COMPLETED | EXPIRED | REVOKED
  status                String   @default("PENDING")

  // Customer-side authorization — an admin inside the target tenant.
  approvedById          String?
  approvedBy            User?    @relation("ImpersonationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  reviewNote            String?

  startedAt             DateTime?
  expiresAt             DateTime?
  endedAt               DateTime?
  endedReason           String?

  requestedAt           DateTime @default(now())

  @@index([status, requestedAt])
  @@index([tenantId, status])
  @@index([subjectUserId])
}

// ----------------------------------------------------------------------
// PHASE 1: SEGREGATION OF DUTIES ENGINE (TRD §6.4)
// ----------------------------------------------------------------------

model SodRule {
  id                  String   @id @default(uuid())
  tenantId            String?  // null = platform default; non-null = tenant-scoped override
  key                 String   // e.g. "dms-author-approver"
  description         String
  subjectType         String   // e.g. "Document", "Invoice", "AccessRequest"
  conflictingActions  String   // JSON array e.g. ["DOCUMENT_CREATED","DOCUMENT_CHECKED_IN"]
  guardedAction       String   // e.g. "DOCUMENT_APPROVED"
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([tenantId, key])
  @@index([guardedAction, subjectType, isActive])
}

model Document {
  id            String   @id @default(uuid())
  code          String
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ownerId       String
  owner         User     @relation(fields: [ownerId], references: [id])
  title         String
  category      String
  classification String
  status        String   // DRAFT, IN_REVIEW, APPROVED, PUBLISHED, ARCHIVED, RETURNED
  version       String   @default("1.0")
  content       String   
  isLockedOut   Boolean  @default(false)
  
  // Phase 2: Checkout locking
  checkedOutBy  String?
  checkedOutAt  DateTime?
  
  // Phase 3: Policy Distribution (Cross-Entity Cloning)
  inheritedFromId String?

  // Phase 2: Retention & Legal Hold (TRD §6.3, §7.1)
  legalHoldMatter  String?
  legalHoldReason  String?
  legalHoldBy      String?
  legalHoldAt      DateTime?

  // File attachment details
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  fileType      String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions      DocumentVersion[]
  approvals     ApprovalQueue[]
  acknowledgements Acknowledgement[]
  chunks        DocumentChunk[]
}

model DocumentVersion {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber String
  changeType    String   @default("Minor")  // Minor or Major
  summary       String?
  content       String?
  fileUrl       String?
  fileName      String?
  fileSize      Int?
  fileType      String?
  fileHash      String?  // SHA-256 of the actual file
  createdById   String?
  createdAt     DateTime @default(now())
}

model ApprovalQueue {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approverId    String
  approver      User     @relation(fields: [approverId], references: [id])
  sequenceOrder Int
  status        String   // PENDING, APPROVED, REJECTED, RETURNED
  decision      String?  // Approval decision notes
  reason        String?  // Rejection/return reason
  signatureHash String?  // SHA-256 digital signature hash
  signerRole    String?  // Role at time of signing
  sessionInfo   String?  // Session/network info at signing time
  reviewedAt    DateTime?
  createdAt     DateTime @default(now())
}

model Acknowledgement {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  completedAt DateTime @default(now())
  ipAddress   String?
}

// ----------------------------------------------------------------------
// NEW MODELS FOR MOCKS
// ----------------------------------------------------------------------

model Ticket {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requesterId   String
  requester     User     @relation("RequestedTickets", fields: [requesterId], references: [id])
  assigneeId    String?
  assignee      User?    @relation("AssignedTickets", fields: [assigneeId], references: [id])
  type          String
  service       String
  subject       String
  description   String

  // TRD §7.3: priority is DERIVED from (impact, urgency) server-side and is
  // never accepted from the client.
  impact        String   @default("Medium")
  urgency       String   @default("Medium")
  priority      String

  status        String
  assignedTeam  String?

  /// Legacy free-text label retained for the existing seed data.
  sla           String?
  /// Computed targets — the values escalation actually runs on.
  slaResponseAt DateTime?
  slaResolveAt  DateTime?
  respondedAt   DateTime?
  resolvedAt    DateTime?
  slaBreached   Boolean  @default(false)
  escalationLevel Int    @default(0)

  catalogItemId String?
  catalogItem   ServiceCatalogItem? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  /// Set when the catalog item routes this ticket through an approval workflow.
  workflowRunId String?
  workflowRun   WorkflowRun? @relation(fields: [workflowRunId], references: [id], onDelete: SetNull)

  dueAt         DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  comments      TicketComment[]
  workNotes     TicketWorkNote[]

  @@index([tenantId, status])
  @@index([assigneeId, status])
  @@index([slaResolveAt, status])
}

model OpenSourceTool {
  id            String   @id @default(uuid())
  name          String
  category      String
  license       String
  maturity      String
  review        String
  deployment    String
  description   String
  annualPrice   Decimal
  risk          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AsmAsset {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  asset         String
  type          String
  owner         String
  authorization String
  score         Int
  critical      Int
  high          Int
  lastScan      DateTime
  branch        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PhishCampaign {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  scope         String
  scenario      String
  language      String
  targets       Int
  status        String
  failureRate   Float
  reportRate    Float
  remediation   Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------
// PHASE 4: ECOSYSTEM SCALE (PUBLIC APIs & WEBHOOKS)
// ----------------------------------------------------------------------

model ApiKey {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String   // e.g., "ERP Integration Key"
  keyHash       String   @unique // Cryptographic hash of the API key
  secretPrefix  String   // First 8 chars for easy identification
  scopes        String   // JSON string Array of permissions e.g., ["read:risks", "write:documents"]
  isActive      Boolean  @default(true)
  expiresAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WebhookEndpoint {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url           String   // The external partner URL to POST to
  secret        String   // Used to generate HMAC SHA-256 signatures for payloads
  events        String   // JSON string Array of events e.g., ["document.published", "risk.critical"]
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ----------------------------------------------------------------------
// PHASE 5: INTELLIGENCE (AI & PREDICTIVE ANALYTICS)
// ----------------------------------------------------------------------

model DocumentChunk {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content       String   
  vectorMock    String   // In production, this would be Unsupported("vector(1536)") using pgvector
  createdAt     DateTime @default(now())
}

model RiskScoreSnapshot {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  score         Float    // 0.0 to 100.0
  riskId        String?
  inherentScore Float?
  residualScore Float?
  recordedAt    DateTime @default(now())

  @@index([riskId])
}


// ═══════════════════════════════════════════════════════════════════════════
// Enterprise risk management — appetite, self-assessment, indicators, losses
// ═══════════════════════════════════════════════════════════════════════════

/// Board-set tolerance per risk category. Residual scores are 1-25
/// (likelihood x impact), so thresholds live on that same scale.
model RiskAppetite {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  category           String
  statement          String
  /// At or below this, risk is carried without further approval.
  appetiteThreshold  Int
  /// Above this, the risk cannot be accepted at all — it must be treated.
  toleranceThreshold Int

  setById            String
  setBy              User     @relation("AppetiteSetter", fields: [setById], references: [id], onDelete: Cascade)
  /// Appetite is only binding once approved by someone other than the setter.
  approvedById       String?
  approvedBy         User?    @relation("AppetiteApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt         DateTime?
  /// Draft | Approved
  status             String   @default("Draft")

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([tenantId, category])
  @@index([tenantId, status])
}

/// Risk & Control Self-Assessment: the first-line mechanism of the Three
/// Lines Model. Management periodically attests to its own controls.
model RcsaCampaign {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ref            String
  title          String
  /// e.g. 2026-H1
  period         String
  dueDate        DateTime

  /// Draft | Launched | Closed
  status         String   @default("Draft")
  launchedById   String?
  launchedBy     User?    @relation("CampaignLauncher", fields: [launchedById], references: [id], onDelete: SetNull)
  launchedAt     DateTime?
  closedAt       DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assessments    RcsaAssessment[]

  @@unique([tenantId, ref])
  @@index([tenantId, status])
}

model RcsaAssessment {
  id               String   @id @default(uuid())
  campaignId       String
  campaign         RcsaCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  implementationId String
  implementation   ControlImplementation @relation(fields: [implementationId], references: [id], onDelete: Cascade)
  respondentId     String
  respondent       User     @relation("RcsaRespondent", fields: [respondentId], references: [id], onDelete: Cascade)

  /// Effective | PartiallyEffective | Ineffective
  designRating     String?
  operatingRating  String?
  narrative        String?

  /// Pending | Submitted
  status           String   @default("Pending")
  submittedAt      DateTime?

  /// A self-reported ineffective control raises an issue automatically.
  issueId          String?
  issue            Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now())

  @@unique([campaignId, implementationId])
  @@index([tenantId, status])
}

/// Key Risk Indicator — a measured signal with escalation thresholds.
model Kri {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  riskId         String?
  risk           Risk?    @relation(fields: [riskId], references: [id], onDelete: SetNull)

  name           String
  unit           String
  /// Higher = a rising value is worse. Lower = a falling value is worse.
  direction      String   @default("Higher")
  amberThreshold Float
  redThreshold   Float
  /// Monthly | Quarterly
  frequency      String   @default("Monthly")

  ownerId        String
  owner          User     @relation("KriOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  readings       KriReading[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
}

model KriReading {
  id           String   @id @default(uuid())
  kriId        String
  kri          Kri      @relation(fields: [kriId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// e.g. 2026-03. One reading per period keeps the trend honest.
  periodLabel  String
  value        Float
  /// Green | Amber | Red — derived from the thresholds at record time.
  breachLevel  String

  recordedById String
  recordedBy   User     @relation("KriRecorder", fields: [recordedById], references: [id], onDelete: Cascade)
  recordedAt   DateTime @default(now())

  /// A red reading raises an issue automatically.
  issueId      String?
  issue        Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  @@unique([kriId, periodLabel])
  @@index([tenantId, breachLevel])
}

/// A risk that actually materialised, with its financial impact. Loss history
/// is the empirical check on whether the register's scoring was realistic.
model LossEvent {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  ref             String
  riskId          String?
  risk            Risk?    @relation(fields: [riskId], references: [id], onDelete: SetNull)

  title           String
  description     String
  /// Basel-style operational risk event category.
  category        String

  occurredAt      DateTime
  discoveredAt    DateTime
  grossAmount     Float
  recoveredAmount Float    @default(0)
  currency        String   @default("SAR")

  /// Open | UnderInvestigation | Closed
  status          String   @default("Open")
  reportedById    String
  reportedBy      User     @relation("LossReporter", fields: [reportedById], references: [id], onDelete: Cascade)

  issueId         String?
  issue           Issue?   @relation(fields: [issueId], references: [id], onDelete: SetNull)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, ref])
  @@index([tenantId, status])
  @@index([tenantId, occurredAt])
}
